@article{Eiter93,
title = "Propositional circumscription and extended closed-world reasoning are {$\Pi^P_2$}-complete",
journal = "Theoretical Computer Science",
volume = "114",
number = "2",
pages = "231-245",
year = "1993",
issn = "0304-3975",
doi = "https://doi.org/10.1016/0304-3975(93)90073-3",
url = "http://www.sciencedirect.com/science/article/pii/0304397593900733",
author = "Thomas Eiter and Georg Gottlob",
abstract = "Circumscription and the closed-world assumption with its variants are well-known nonmonotonic techniques for reasoning with incomplete knowledge. Their complexity in the propositional case has been studied in detail for fragments of propositional logic. One open problem is whether the deduction problem for arbitrary propositional theories under the extended closed-world assumption or under circumscription is $\Pi^P_2$-complete, i.e., complete for a class of the second level of the polynomial hierarchy. We answer this question by proving these problems $\Pi^P_2$-complete, and we show how this result applies to other variants of closed-world reasoning."
}

